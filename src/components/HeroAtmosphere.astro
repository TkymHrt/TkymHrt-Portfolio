</style>

<script>
  const atmosphere = document.querySelector<HTMLElement>(
    "[data-hero-atmosphere]",
  );

  if (atmosphere) {
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const hero = atmosphere.closest<HTMLElement>(".hero-section");
    let isVisible = true;
    let observer: IntersectionObserver | undefined;

    const syncMotionState = () => {
      atmosphere.dataset.motionState = reduceMotion.matches
        ? "reduced"
        : document.hidden || !isVisible
          ? "paused"
          : "running";
    };

    const startObserving = () => {
      if (!hero || observer) return;
      observer = new IntersectionObserver(
        ([entry]) => {
          isVisible = entry?.isIntersecting ?? true;
          syncMotionState();
        },
        { rootMargin: "96px 0px" },
      );
      observer.observe(hero);
    };

    const stopObserving = () => {
      observer?.disconnect();
      observer = undefined;
      isVisible = true;
    };

    const syncMotionPreference = () => {
      if (reduceMotion.matches) {
        stopObserving();
      } else {
        startObserving();
      }
      syncMotionState();
    };

    reduceMotion.addEventListener("change", syncMotionPreference);
    document.addEventListener("visibilitychange", syncMotionState, {
      passive: true,
    });
    syncMotionPreference();
  }
</script>
