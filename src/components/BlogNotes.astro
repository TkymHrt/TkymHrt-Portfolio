---
import Icon from "./Icon.astro";

import { entryPath, getWritingEntries, toDateTime } from "../lib/content";

const entries = (await getWritingEntries()).slice(0, 3);
const formatCompactDate = (date: Date) =>
  date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<section id="blog" class="section-shell" aria-labelledby="blog-title">
  <div class="content-wrap">
    <div class="flex items-center justify-between gap-5">
      <h2 id="blog-title" class="section-title">
        <span class="section-icon" aria-hidden="true">
          <Icon name="tabler:pencil-filled" size={22} />
        </span>
        Blog
      </h2>

      <a
        class="rounded-control hover:text-primary-strong inline-flex min-h-11 items-center gap-2 px-2 text-[0.76rem] font-semibold no-underline transition-colors duration-150"
        href="/blog/"
      >
        <span>すべての投稿を見る</span>
        <Icon
          name="tabler:arrow-right"
          size={17}
          strokeWidth={1.8}
          aria-hidden="true"
        />
      </a>
    </div>

    <ul class="writing-list">
      {
        entries.map((entry) => (
          <li>
            <a
              class="writing-link"
              href={entryPath(entry.collection, entry.id)}
            >
              <span class="writing-title">{entry.data.title}</span>
              <time
                class="writing-time"
                datetime={toDateTime(entry.data.publishedAt)}
              >
                {formatCompactDate(entry.data.publishedAt)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .writing-list {
    margin: 1.25rem 0 0;
    padding-left: 1.3rem;
    list-style: disc;
  }

  .writing-list li + li {
    margin-top: 0.1rem;
  }

  .writing-list li::marker {
    color: var(--color-primary);
    font-size: 0.8rem;
  }

  .writing-link {
    display: grid;
    min-height: 3rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    border-radius: var(--radius-control);
    padding: 0.4rem 0.85rem;
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }

  .writing-link:hover {
    background: var(--color-surface-soft);
  }

  .writing-title {
    min-width: 0;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .writing-time {
    color: var(--color-muted);
    font-size: 0.68rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      monospace;
    font-weight: 600;
    inline-size: 10ch;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
</style>
