---
import { Image } from "astro:assets";
import profileAvatar from "../assets/profile-illustration.png";
import { profile } from "../data/portfolio";
import HeroAtmosphere from "./HeroAtmosphere.astro";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
---

<section
  id="about"
  class="hero-section scroll-mt-20"
  aria-labelledby="hero-title"
>
  <HeroAtmosphere />

  <div class="hero-content content-wrap">
    <div class="avatar" aria-hidden="true">
      <Image
        class="avatar-image"
        src={profileAvatar}
        alt=""
        width={120}
        height={120}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <h1 id="hero-title">I'm {profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
    <p class="hero-intro">{profile.intro}</p>

    <div class="hero-actions" aria-label="主要リンク">
      <a class="primary-button hero-works-button" href="/works/">
        Worksを見る
        <Icon
          name="tabler:arrow-right"
          size={17}
          strokeWidth={2}
          aria-hidden="true"
        />
      </a>
      <a class="secondary-button hero-about-button" href="/about/">
        About Me
      </a>
    </div>

    <SocialLinks class="mt-6 justify-center gap-2 [&_.icon-link]:size-11" />
  </div>

  <a class="scroll-cue" href="#skills" aria-label="次のセクション「Skills」へ">
    <Icon
      name="tabler:chevron-down"
      size={24}
      strokeWidth={2}
      aria-hidden="true"
    />
  </a>
</section>

<style>
  .hero-section {
    position: relative;
    display: flex;
    min-height: clamp(32rem, 60svh, 38rem);
    align-items: stretch;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(2.75rem, 6vw, 4.75rem) clamp(1.25rem, 4vw, 3rem)
      clamp(4.5rem, 7vw, 5.25rem);
    background: var(--color-surface-soft);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .avatar {
    position: relative;
    display: grid;
    width: clamp(6.25rem, 10vw, 7.5rem);
    height: clamp(6.25rem, 10vw, 7.5rem);
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 2px solid
      color-mix(in oklch, var(--color-primary) 48%, var(--color-line));
    border-radius: 9999px;
    background: var(--color-surface);
    box-shadow:
      0 0 0 0.45rem color-mix(in oklch, var(--color-accent) 16%, transparent),
      0 0.5rem 1.1rem color-mix(in oklch, var(--color-ink) 13%, transparent);
  }

  .avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.16);
  }

  #hero-title {
    margin: 1.4rem 0 0;
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .hero-role {
    margin: 0.55rem 0 0;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    font-weight: 700;
    line-height: 1.75;
  }

  .hero-intro {
    max-width: 42rem;
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: clamp(0.925rem, 1.8vw, 1rem);
    font-weight: 500;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .hero-actions a {
    min-width: 10.5rem;
  }

  .hero-works-button {
    border-color: color-mix(
      in oklch,
      var(--color-primary-strong) 28%,
      var(--color-primary)
    );
    background: var(--color-primary);
    color: var(--color-on-bright);
    box-shadow: 0 0.4rem 0.9rem
      color-mix(in oklch, var(--color-primary) 22%, transparent);
  }

  .hero-works-button:hover {
    border-color: color-mix(
      in oklch,
      var(--color-primary-strong) 45%,
      var(--color-primary)
    );
    background: color-mix(
      in oklch,
      var(--color-primary) 82%,
      var(--color-accent)
    );
  }

  .hero-about-button {
    border-color: color-mix(
      in oklch,
      var(--color-accent) 58%,
      var(--color-primary-strong)
    );
    background: color-mix(
      in oklch,
      var(--color-accent) 24%,
      var(--color-surface)
    );
    color: var(--color-ink);
  }

  .hero-about-button:hover {
    border-color: color-mix(
      in oklch,
      var(--color-accent) 68%,
      var(--color-primary-strong)
    );
    background: color-mix(
      in oklch,
      var(--color-accent) 38%,
      var(--color-surface)
    );
  }

  .scroll-cue {
    position: absolute;
    z-index: 3;
    bottom: 1.5rem;
    left: 50%;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    transform: translateX(-50%);
    place-items: center;
    border: 1px solid
      color-mix(in oklch, var(--color-primary) 40%, var(--color-line));
    border-radius: 9999px;
    background: color-mix(
      in oklch,
      var(--color-accent) 20%,
      var(--color-surface)
    );
    color: var(--color-primary-strong);
    text-decoration: none;
    transition:
      transform 260ms var(--ease-out-expo),
      border-color 160ms ease-out,
      background-color 160ms ease-out;
  }

  .scroll-cue:hover {
    transform: translate(-50%, 0.2rem);
    border-color: var(--color-primary);
    background: color-mix(
      in oklch,
      var(--color-accent) 34%,
      var(--color-surface)
    );
  }

  @media (max-width: 39.999rem) {
    .hero-section {
      min-height: calc(100vh - 7rem);
      min-height: calc(100svh - 7rem);
      padding-top: clamp(2.5rem, 8svh, 4rem);
      padding-bottom: 4.75rem;
    }

    .hero-actions {
      width: min(100%, 22rem);
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-actions a {
      width: 100%;
      min-height: 3rem;
    }
  }
</style>
