---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Box from "@lucide/astro/icons/box";
import Circle from "@lucide/astro/icons/circle";
import Cloud from "@lucide/astro/icons/cloud";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import Heart from "@lucide/astro/icons/heart";
import MapPin from "@lucide/astro/icons/map-pin";
import Sparkles from "@lucide/astro/icons/sparkles";
import UserRound from "@lucide/astro/icons/user-round";
import { profile } from "../data/portfolio";
import SocialLinks from "./SocialLinks.astro";
---

<section
  id="about"
  class="bg-surface-soft scroll-mt-20 px-5 py-5 sm:px-8 sm:py-12 lg:px-12 lg:py-14"
  aria-labelledby="hero-title"
>
  <div
    class="content-wrap grid items-center gap-10 lg:grid-cols-[1.45fr_0.8fr]"
  >
    <div class="min-w-0">
      <div
        class="flex flex-col items-center gap-3 text-center sm:flex-row sm:gap-6 sm:text-left"
      >
        <div class="avatar" aria-hidden="true">
          <span class="avatar-shirt"></span>
          <UserRound class="avatar-icon" size={63} stroke-width={1.45} />
        </div>

        <div>
          <h1
            id="hero-title"
            class="m-0 text-[clamp(1.4rem,5vw,2.35rem)] leading-[1.35] font-bold tracking-[-0.025em]"
          >
            {profile.name}のポートフォリオ
          </h1>
          <p
            class="mt-1.5 text-[0.82rem] leading-6 font-semibold sm:mt-2 sm:text-base sm:leading-7"
          >
            {profile.role}
          </p>
        </div>
      </div>

      <p
        id="about-details"
        class="mx-auto mt-3 max-w-[42rem] text-center text-[0.86rem] leading-7 font-medium sm:mx-0 sm:mt-7 sm:pl-[7.95rem] sm:text-left sm:text-base sm:leading-8"
      >
        {profile.intro}
      </p>

      <ul
        class="mx-auto mt-3 grid max-w-[38rem] list-none gap-1 p-0 text-left text-[0.75rem] font-semibold sm:mx-0 sm:mt-6 sm:flex sm:max-w-none sm:flex-wrap sm:gap-x-6 sm:gap-y-3 sm:pl-[7.95rem] sm:text-[0.78rem]"
        aria-label="プロフィール概要"
      >
        {
          profile.facts.map((fact) => (
            <li class="flex min-h-5 items-center gap-2 sm:min-h-6">
              {fact.id === "study" ? (
                <GraduationCap
                  class="text-primary-strong shrink-0"
                  size={17}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              ) : fact.id === "interest" ? (
                <Heart
                  class="text-primary-strong shrink-0"
                  size={17}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              ) : (
                <MapPin
                  class="text-primary-strong shrink-0"
                  size={17}
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              )}
              <span>{fact.label}</span>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-4 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:pl-[7.95rem]"
        aria-label="主要リンク"
      >
        <a class="primary-button w-full sm:w-auto" href="#works">
          Worksを見る
          <ArrowRight size={17} stroke-width={2} aria-hidden="true" />
        </a>
        <a class="secondary-button w-full sm:w-auto" href="#about-details">
          About Me
        </a>
      </div>

      <SocialLinks
        class="mt-3 justify-center sm:mt-5 sm:pl-[7.95rem] lg:hidden"
      />
    </div>

    <div class="hero-art hidden lg:block" aria-hidden="true">
      <span class="hero-ring hero-ring--left"></span>
      <span class="hero-ring hero-ring--right"></span>
      <span class="hero-dot hero-dot--one"></span>
      <span class="hero-dot hero-dot--two"></span>
      <Cloud class="hero-cloud" size={54} stroke-width={1.25} />
      <Box class="hero-box" size={74} stroke-width={1.25} />
      <div class="hero-arch"></div>
      <div class="hero-cone"></div>
      <Circle class="hero-sphere" size={42} stroke-width={1.2} />
      <Sparkles
        class="hero-spark hero-spark--one"
        size={24}
        stroke-width={1.4}
      />
      <Sparkles
        class="hero-spark hero-spark--two"
        size={18}
        stroke-width={1.4}
      />
    </div>
  </div>
</section>

<style>
  .avatar {
    position: relative;
    display: grid;
    width: 6.5rem;
    height: 6.5rem;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 1.5px solid var(--color-ink);
    border-radius: 9999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 0.45rem var(--color-surface-soft);
  }

  .avatar::after {
    position: absolute;
    inset: 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: inherit;
    content: "";
  }

  .avatar-shirt {
    position: absolute;
    right: 1.45rem;
    bottom: -0.8rem;
    left: 1.45rem;
    height: 2.6rem;
    border-radius: 9999px 9999px 0 0;
    background: var(--color-accent);
  }

  .avatar-icon {
    position: relative;
    z-index: 1;
    margin-top: 0.35rem;
    color: var(--color-ink);
  }

  .hero-art {
    position: relative;
    min-height: 20rem;
  }

  .hero-ring,
  .hero-dot {
    position: absolute;
    display: block;
    border: 1.5px solid
      color-mix(in oklch, var(--color-primary) 70%, transparent);
    border-radius: 9999px;
  }

  .hero-ring--left {
    top: 3.1rem;
    left: 1.2rem;
    width: 2.1rem;
    height: 2.1rem;
  }

  .hero-ring--right {
    right: 1.1rem;
    bottom: 4rem;
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero-dot--one {
    top: 6.8rem;
    right: 0;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-accent);
  }

  .hero-dot--two {
    bottom: 2.1rem;
    left: 3.6rem;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--color-primary);
  }

  .hero-cloud {
    position: absolute;
    top: 0.3rem;
    right: 4rem;
    color: color-mix(
      in oklch,
      var(--color-primary-strong) 70%,
      var(--color-line)
    );
  }

  .hero-box {
    position: absolute;
    top: 7.3rem;
    left: 0.5rem;
    color: color-mix(
      in oklch,
      var(--color-primary-strong) 75%,
      var(--color-line)
    );
  }

  .hero-arch {
    position: absolute;
    right: 1.9rem;
    bottom: 1.9rem;
    width: 7.6rem;
    height: 6.4rem;
    border: 1rem solid
      color-mix(in oklch, var(--color-accent) 55%, var(--color-surface));
    border-bottom: 0;
    border-radius: 9999px 9999px 0 0;
    box-shadow: inset 0 0 0 1px
      color-mix(in oklch, var(--color-primary-strong) 55%, transparent);
  }

  .hero-cone {
    position: absolute;
    bottom: 2.35rem;
    left: 5.2rem;
    width: 0;
    height: 0;
    border-right: 1.35rem solid transparent;
    border-bottom: 5.3rem solid
      color-mix(in oklch, var(--color-primary) 32%, var(--color-surface));
    border-left: 1.35rem solid transparent;
    filter: drop-shadow(
      0 1px 0 color-mix(in oklch, var(--color-primary-strong) 60%, transparent)
    );
  }

  .hero-sphere {
    position: absolute;
    top: 4.35rem;
    right: 1.75rem;
    color: var(--color-primary-strong);
    fill: color-mix(in oklch, var(--color-accent) 35%, var(--color-surface));
  }

  .hero-spark {
    position: absolute;
    color: var(--color-primary-strong);
  }

  .hero-spark--one {
    top: 1rem;
    left: 0;
  }

  .hero-spark--two {
    right: 0;
    bottom: 0;
  }

  @media (max-width: 39.999rem) {
    .avatar {
      width: 5rem;
      height: 5rem;
    }
  }
</style>
