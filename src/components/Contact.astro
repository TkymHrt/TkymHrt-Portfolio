---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Mail from "@lucide/astro/icons/mail";
import SocialLinks from "./SocialLinks.astro";
---

<section
  id="contact"
  class="section-shell lg:border-line lg:border-l"
  aria-labelledby="contact-title"
>
  <div class="mx-auto max-w-[28rem] lg:mx-0">
    <h2 id="contact-title" class="section-title">
      <span
        class="section-icon bg-surface-soft text-primary-strong"
        aria-hidden="true"
      >
        <Mail size={16} stroke-width={1.8} />
      </span>
      Contact
    </h2>

    <p class="mt-5 max-w-[24rem] text-[0.84rem] leading-7 font-medium">
      お仕事・ご相談は<br />お気軽にご連絡ください。
    </p>

    <a
      class="primary-button mt-4"
      href="https://github.com/TkymHrt"
      aria-label="TkymHrtのGitHubプロフィールを見る"
    >
      GitHubを見る
      <ArrowRight size={17} stroke-width={2} aria-hidden="true" />
    </a>

    <SocialLinks class="mt-5" />
  </div>
</section>
