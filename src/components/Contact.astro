---
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
---

<section id="contact" class="section-shell" aria-labelledby="contact-title">
  <div class="content-wrap mx-auto max-w-2xl">
    <h2 id="contact-title" class="section-title">
      <span class="section-icon" aria-hidden="true">
        <Icon name="tabler:mail-filled" size={22} />
      </span>
      Contact
    </h2>

    <div class="mt-5 flex items-center justify-between gap-4 sm:gap-6">
      <p
        class="m-0 min-w-0 text-[0.8rem] leading-7 font-medium sm:text-[0.84rem]"
      >
        お仕事・ご相談は<br />お気軽にご連絡ください。
      </p>

      <a
        class="primary-button shrink-0 px-4 text-[0.82rem] sm:px-6 sm:text-[0.9rem]"
        href="https://github.com/TkymHrt"
        aria-label="TkymHrtのGitHubプロフィールを見る"
      >
        GitHubを見る
        <Icon
          name="tabler:arrow-right"
          size={17}
          strokeWidth={2}
          aria-hidden="true"
        />
      </a>
    </div>

    <SocialLinks
      class="mt-6 justify-center gap-3 sm:mt-7 sm:gap-4 lg:gap-3 [&_.icon-link]:size-12 lg:[&_.icon-link]:size-11"
    />
  </div>
</section>
