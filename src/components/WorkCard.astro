---
import Icon from "./Icon.astro";
import type { CollectionEntry } from "astro:content";

import { entryPath } from "../lib/content";
import WorkVisual from "./WorkVisual.astro";

interface Props {
  work: CollectionEntry<"works">;
  variant?: "lead" | "compact" | "row";
  eager?: boolean;
}

const { work, variant = "compact", eager = false } = Astro.props;
const { data } = work;
const description = variant === "row" ? data.description : data.summary;
---

<a
  class:list={[
    "project-card group border-line bg-surface ease-out-expo hover:border-primary/60 hover:shadow-card min-w-0 overflow-hidden border no-underline transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1",
    `project-card--${variant}`,
  ]}
  href={entryPath(work.collection, work.id)}
  aria-labelledby={`${work.id}-${variant}-title`}
>
  <WorkVisual
    class="project-card__visual"
    visual={data.visual}
    cover={data.cover}
    eager={eager}
  />

  <div class="project-card__body">
    <div class="flex items-start justify-between gap-4">
      <div>
        {data.draft && <span class="draft-badge">下書き</span>}
        <h3
          id={`${work.id}-${variant}-title`}
          class="m-0 text-[1.05rem] leading-7 font-bold tracking-[-0.01em]"
        >
          {data.title}
        </h3>
      </div>
      <Icon
        name="tabler:arrow-up-right"
        class="text-primary-strong mt-1 shrink-0 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        size={18}
        strokeWidth={1.8}
        aria-hidden="true"
      />
    </div>

    <p class="text-muted mt-1 text-[0.8rem] leading-6 font-medium">
      {description}
    </p>

    <ul class="mt-3 flex list-none flex-wrap gap-1.5 p-0" aria-label="使用技術">
      {
        data.tags.map((tag) => (
          <li class="border-line bg-surface text-muted rounded-md border px-2 py-1 text-[0.64rem] leading-4 font-semibold">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</a>

<style>
  .project-card {
    border-radius: var(--radius-card);
  }

  .project-card__visual {
    border-bottom: 1px solid var(--color-line);
  }

  .project-card__body {
    padding: 1rem;
  }

  .project-card--lead .project-card__visual {
    min-height: 15.5rem;
  }

  .project-card--compact {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.72fr) minmax(0, 1.28fr);
  }

  .project-card--compact .project-card__visual {
    min-height: 100%;
    border-right: 1px solid var(--color-line);
    border-bottom: 0;
  }

  .project-card--compact :global(.visual-icon) {
    width: 3.5rem;
  }

  .project-card--row {
    display: grid;
    grid-template-columns: minmax(13rem, 0.85fr) minmax(0, 1.15fr);
  }

  .project-card--row .project-card__visual {
    min-height: 13rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 0;
  }

  .project-card--row .project-card__body {
    align-self: center;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }

  @media (max-width: 40rem) {
    .project-card--lead .project-card__visual {
      min-height: 11.5rem;
    }

    .project-card--compact,
    .project-card--row {
      grid-template-columns: 1fr;
    }

    .project-card--compact .project-card__visual,
    .project-card--row .project-card__visual {
      min-height: 9rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
  }
</style>
