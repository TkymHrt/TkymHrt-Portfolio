---
import type { HTMLAttributes } from "astro/types";
import { icons as simpleIcons } from "@iconify-json/simple-icons";
import { icons as tablerIcons } from "@iconify-json/tabler";

interface Props extends Omit<
  HTMLAttributes<"svg">,
  "name" | "width" | "height"
> {
  name: `tabler:${string}` | `simple-icons:${string}`;
  size?: number | string;
  strokeWidth?: number;
}

const {
  name,
  size = 24,
  strokeWidth,
  class: className,
  "aria-hidden": ariaHidden = true,
  ...attributes
} = Astro.props;
const separatorIndex = name.indexOf(":");
const prefix = name.slice(0, separatorIndex);
const iconName = name.slice(separatorIndex + 1);
const iconSet = prefix === "tabler" ? tablerIcons : simpleIcons;
const icon = iconSet.icons[iconName];

if (!icon) {
  throw new Error(`Unknown icon: ${name}`);
}

const body =
  strokeWidth === undefined
    ? icon.body
    : icon.body.replaceAll(
        /stroke-width="[^"]+"/gu,
        `stroke-width="${strokeWidth}"`,
      );
const width = icon.width ?? iconSet.width ?? 24;
const height = icon.height ?? iconSet.height ?? 24;
const left = icon.left ?? 0;
const top = icon.top ?? 0;
---

<svg
  {...attributes}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={`${left} ${top} ${width} ${height}`}
  class={className}
  aria-hidden={ariaHidden}
  focusable="false"
>
  <Fragment set:html={body} />
</svg>
