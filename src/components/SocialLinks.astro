---
import Braces from "@lucide/astro/icons/braces";
import Camera from "@lucide/astro/icons/camera";
import { socialLinks } from "../data/portfolio";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<ul class:list={["flex list-none flex-wrap gap-2 p-0", className]}>
  {
    socialLinks.map((link) => (
      <li>
        <a
          class="icon-link"
          href={link.href}
          aria-label={`${link.label}を開く`}
          rel="me"
        >
          {link.id === "github" ? (
            <Braces size={18} stroke-width={1.8} aria-hidden="true" />
          ) : link.id === "instagram" ? (
            <Camera size={18} stroke-width={1.8} aria-hidden="true" />
          ) : (
            <span aria-hidden="true">{link.shortLabel}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>
