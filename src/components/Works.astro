---
import Icon from "./Icon.astro";

import { getWorks } from "../lib/content";
import WorkCard from "./WorkCard.astro";

const allWorks = await getWorks();
const featuredWorks = allWorks.filter(({ data }) => data.featured).slice(0, 3);
const works = featuredWorks.length > 0 ? featuredWorks : allWorks.slice(0, 3);
const [leadWork, ...otherWorks] = works;
---

<section id="works" class="section-shell" aria-labelledby="works-title">
  <div class="content-wrap">
    <div class="flex items-center justify-between gap-5">
      <h2 id="works-title" class="section-title">
        <span class="section-icon" aria-hidden="true">
          <Icon name="tabler:briefcase-filled" size={22} />
        </span>
        Works
      </h2>

      <a
        class="rounded-control hover:text-primary-strong inline-flex min-h-11 items-center gap-2 px-2 text-[0.76rem] font-semibold no-underline transition-colors duration-150"
        href="/works/"
      >
        <span>すべての作品を見る</span>
        <Icon
          name="tabler:arrow-right"
          size={17}
          strokeWidth={1.8}
          aria-hidden="true"
        />
      </a>
    </div>

    {
      leadWork ? (
        <div class="mt-6 grid items-stretch gap-4 lg:grid-cols-[1.14fr_0.86fr]">
          <WorkCard work={leadWork} variant="lead" eager />
          {otherWorks.length > 0 && (
            <div class="grid content-stretch gap-4">
              {otherWorks.map((work) => (
                <WorkCard work={work} variant="compact" />
              ))}
            </div>
          )}
        </div>
      ) : (
        <p class="text-muted mt-6">公開中の作品はまだありません。</p>
      )
    }
  </div>
</section>
