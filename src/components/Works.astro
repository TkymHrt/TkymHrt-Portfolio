---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Camera from "@lucide/astro/icons/camera";
import ClipboardCheck from "@lucide/astro/icons/clipboard-check";
import Sparkles from "@lucide/astro/icons/sparkles";
import Sprout from "@lucide/astro/icons/sprout";
import UserRound from "@lucide/astro/icons/user-round";
import { works } from "../data/portfolio";

const projectIcons = {
  "plant-log": Sprout,
  "task-flow": ClipboardCheck,
  "photo-note": Camera,
} as const;
---

<section id="works" class="section-shell" aria-labelledby="works-title">
  <div class="content-wrap">
    <div class="flex items-center justify-between gap-5">
      <h2 id="works-title" class="section-title">
        <span
          class="section-icon bg-surface-soft text-primary-strong"
          aria-hidden="true"
        >
          <UserRound size={17} stroke-width={1.8} />
        </span>
        Works
      </h2>

      <a
        class="rounded-control hover:text-primary-strong inline-flex min-h-11 items-center gap-2 px-2 text-[0.76rem] font-semibold no-underline transition-colors duration-150"
        href="https://github.com/TkymHrt?tab=repositories"
      >
        <span>すべての作品を見る</span>
        <ArrowRight size={17} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>

    <div
      class="project-grid mt-6 grid auto-cols-[min(84vw,20.5rem)] grid-flow-col gap-4 overflow-x-auto pb-3 sm:auto-cols-auto sm:grid-flow-row sm:grid-cols-2 sm:overflow-visible sm:pb-0 lg:grid-cols-3"
      aria-label="制作実績一覧"
    >
      {
        works.map((work) => {
          const Icon = projectIcons[work.id];
          return (
            <a
              class="project-card group rounded-card border-line bg-surface ease-out-expo hover:border-primary/60 hover:shadow-card min-w-0 snap-start overflow-hidden border no-underline transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1"
              href={work.url}
              aria-labelledby={`${work.id}-title`}
            >
              <div
                class="project-art"
                data-project={work.id}
                aria-hidden="true"
              >
                <span class="art-floor" />
                <span class="art-orb art-orb--one" />
                <span class="art-orb art-orb--two" />
                <Icon class="art-icon" size={74} stroke-width={1.35} />
                <Sparkles class="art-spark" size={20} stroke-width={1.4} />
              </div>

              <div class="p-4">
                <h3
                  id={`${work.id}-title`}
                  class="m-0 text-base leading-6 font-bold tracking-[-0.01em]"
                >
                  {work.title}
                </h3>
                <p class="text-muted mt-1 text-[0.78rem] leading-6 font-medium">
                  {work.description}
                </p>
                <ul
                  class="mt-3 flex list-none flex-wrap gap-1.5 p-0"
                  aria-label="使用技術"
                >
                  {work.tags.map((tag) => (
                    <li class="border-line bg-surface text-muted rounded-[6px] border px-2 py-1 text-[0.64rem] leading-4 font-semibold">
                      {tag}
                    </li>
                  ))}
                </ul>
                <span class="visually-hidden">リポジトリ一覧で作品を見る</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project-grid {
    contain: inline-size;
    scroll-padding-inline: 1px;
    scroll-snap-type: inline mandatory;
    scrollbar-color: var(--color-line) transparent;
    scrollbar-width: thin;
  }

  .project-art {
    --art-color: var(--color-primary-strong);
    --art-fill: color-mix(
      in oklch,
      var(--color-accent) 45%,
      var(--color-surface)
    );
    position: relative;
    display: grid;
    min-height: 10.25rem;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface-soft);
    color: var(--art-color);
  }

  .project-art[data-project="plant-log"] {
    --art-color: oklch(0.48 0.1 125);
    --art-fill: oklch(0.89 0.08 100);
  }

  .project-art[data-project="task-flow"] {
    --art-color: oklch(0.52 0.16 54);
    --art-fill: oklch(0.91 0.07 78);
  }

  .project-art[data-project="photo-note"] {
    --art-color: oklch(0.39 0.03 65);
    --art-fill: oklch(0.83 0.045 82);
  }

  .project-art::before,
  .project-art::after {
    position: absolute;
    bottom: 1.2rem;
    width: 3.5rem;
    height: 4.8rem;
    border: 1px solid color-mix(in oklch, var(--art-color) 58%, transparent);
    border-radius: 9999px 9999px 0.75rem 0.75rem;
    background: color-mix(in oklch, var(--art-fill) 72%, var(--color-surface));
    content: "";
  }

  .project-art::before {
    left: 1.3rem;
    rotate: -8deg;
    scale: 0.72;
  }

  .project-art::after {
    right: 1.1rem;
    rotate: 7deg;
    scale: 0.58;
  }

  .art-floor {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    height: 1px;
    background: color-mix(in oklch, var(--art-color) 35%, var(--color-line));
  }

  .art-icon {
    position: relative;
    z-index: 1;
    fill: var(--art-fill);
    filter: drop-shadow(
      0 2px 1px color-mix(in oklch, var(--art-color) 16%, transparent)
    );
  }

  .art-orb {
    position: absolute;
    display: block;
    border: 1px solid color-mix(in oklch, var(--art-color) 55%, transparent);
    border-radius: 9999px;
    background: color-mix(in oklch, var(--art-fill) 75%, var(--color-surface));
  }

  .art-orb--one {
    top: 1.2rem;
    left: 1.2rem;
    width: 1rem;
    height: 1rem;
  }

  .art-orb--two {
    top: 2.1rem;
    right: 2rem;
    width: 1.8rem;
    height: 1.8rem;
  }

  .art-spark {
    position: absolute;
    top: 1rem;
    right: 0.9rem;
    color: var(--color-primary-strong);
  }

  @media (max-width: 39.999rem) {
    .project-grid {
      margin-right: -1.25rem;
      margin-left: -1.25rem;
      padding-right: 1.25rem;
      padding-left: 1.25rem;
      scroll-padding-inline: 1.25rem;
    }

    .project-art {
      min-height: 9rem;
    }
  }
</style>
