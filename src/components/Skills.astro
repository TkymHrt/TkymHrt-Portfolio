---
import Atom from "@lucide/astro/icons/atom";
import Cloud from "@lucide/astro/icons/cloud";
import CodeXml from "@lucide/astro/icons/code-xml";
import FileCode from "@lucide/astro/icons/file-code";
import GitBranch from "@lucide/astro/icons/git-branch";
import Monitor from "@lucide/astro/icons/monitor";
import Palette from "@lucide/astro/icons/palette";
import Star from "@lucide/astro/icons/star";
import WavesHorizontal from "@lucide/astro/icons/waves-horizontal";
import { skills } from "../data/portfolio";

const skillIcons = {
  html: CodeXml,
  typescript: FileCode,
  react: Atom,
  tailwind: WavesHorizontal,
  git: GitBranch,
  figma: Palette,
  deploy: Cloud,
  editor: Monitor,
} as const;
---

<section id="skills" class="section-shell" aria-labelledby="skills-title">
  <div class="content-wrap">
    <h2 id="skills-title" class="section-title">
      <span class="section-icon" aria-hidden="true">
        <Star size={17} stroke-width={1.8} />
      </span>
      Skills
    </h2>

    <ul
      class="mt-4 grid list-none grid-cols-2 gap-2 p-0 sm:mt-6 sm:grid-cols-3 lg:grid-cols-4"
    >
      {
        skills.map((skill) => {
          const Icon = skillIcons[skill.id];
          return (
            <li class="rounded-control border-line bg-surface flex min-h-10 min-w-0 items-center gap-2 border px-3 py-1.5 text-[0.68rem] leading-5 font-semibold sm:min-h-11 sm:py-2 sm:text-xs">
              <Icon
                class="text-primary-strong shrink-0"
                size={16}
                stroke-width={1.8}
                aria-hidden="true"
              />
              <span class="min-w-0">{skill.label}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
