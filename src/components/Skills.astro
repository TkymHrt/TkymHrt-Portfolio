---
import Icon from "./Icon.astro";
import { skills } from "../data/portfolio";

const skillIcons = {
  html: "tabler:code",
  typescript: "tabler:file-code",
  react: "tabler:brand-react",
  tailwind: "tabler:brand-tailwind",
  git: "tabler:git-branch",
  figma: "tabler:brand-figma",
  deploy: "tabler:cloud",
  editor: "tabler:device-desktop",
} as const;
---

<section id="skills" class="section-shell" aria-labelledby="skills-title">
  <div class="content-wrap">
    <h2 id="skills-title" class="section-title">
      <span class="section-icon" aria-hidden="true">
        <Icon name="tabler:star-filled" size={22} />
      </span>
      Skills
    </h2>

    <ul
      class="mt-4 grid list-none grid-cols-2 gap-2 p-0 sm:mt-6 sm:grid-cols-3 lg:grid-cols-4"
    >
      {
        skills.map((skill) => {
          const iconName = skillIcons[skill.id];
          return (
            <li class="rounded-control border-line bg-surface flex min-h-10 min-w-0 items-center gap-2 border px-3 py-1.5 text-[0.68rem] leading-5 font-semibold sm:min-h-11 sm:py-2 sm:text-xs">
              <Icon
                name={iconName}
                class="text-primary-strong shrink-0"
                size={16}
                strokeWidth={1.8}
                aria-hidden="true"
              />
              <span class="min-w-0">{skill.label}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
