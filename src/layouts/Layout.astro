---
import { Font } from "astro:assets";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../assets/app.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  structuredData?: Record<string, unknown> | null;
}

const {
  title = "TkymHrtのポートフォリオ",
  description = "大学4年生のフロントエンドエンジニア、TkymHrtのスキル・制作実績・技術記事・ブログを紹介します。",
  type = "website",
  publishedAt,
  updatedAt,
  structuredData,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "TkymHrt",
  url: "https://github.com/TkymHrt",
  jobTitle: "フロントエンドエンジニア",
  sameAs: [
    "https://github.com/TkymHrt",
    "https://x.com/ForHobbiesBY",
    "https://www.instagram.com/tkymhrt",
  ],
};

const jsonLd =
  structuredData === undefined && Astro.url.pathname === "/"
    ? personStructuredData
    : structuredData;

const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const usesHomeFont = pathSegments.length === 0;
---

<!doctype html>
<html
  lang="ja"
  style={`--font-active: var(--font-line-seed-jp-${usesHomeFont ? "home" : "content"})`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fffaf2"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#211e1b"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      usesHomeFont ? (
        <Font cssVariable="--font-line-seed-jp-home" preload />
      ) : (
        <Font cssVariable="--font-line-seed-jp-content" preload />
      )
    }
    <script is:inline>
      (() => {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem("theme");
        } catch {
          /* Theme detection falls back to the operating system setting. */
        }
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <div class="site-shell" id="top">
      <Header />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
